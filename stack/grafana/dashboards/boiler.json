    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "boiler_state",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Idle",
         "color": "text",
         "index": 0
        },
        "1": {
         "text": "Heating",
         "color": "orange",
         "index": 1
        },
        "2": {
         "text": "Hot water",
         "color": "blue",
         "index": 2
        },
        "3": {
         "text": "Unclear",
         "color": "yellow",
         "index": 3
        },
        "-1": {
         "text": "Offline",
         "color": "red",
         "index": 4
        },
        "-2": {
         "text": "Setting up",
         "color": "text",
         "index": 5
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
