{
 "uid": "boiler",
 "title": "Boiler",
 "tags": [
  "solar",
  "boiler"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "description": "The boiler module: burner, floor temperatures, heat delivered and faults. Empty until the boiler module is on.",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "tu",
    "label": "Temperature",
    "type": "custom",
    "query": "°F : 1,°C : 0",
    "current": {
     "text": "°F",
     "value": "1"
    },
    "options": [],
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Boiler now",
   "description": "",
