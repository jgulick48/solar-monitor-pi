{
 "uid": "history",
 "title": "History: this year against last",
 "tags": [
  "solar"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1h",
 "time": {
  "from": "now-90d",
  "to": "now"
 },
 "description": "Per-day totals stored by the box (site_day_*), against the same days a year earlier. The box's History page has the months as a table.",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Solar: 30-day total against last year",
   "description": "Each point is the total of the 30 days before it; the dashed line is the same 30 days a year earlier.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum_over_time(site_day_solar_kwh[30d])",
     "legendFormat": "the last 30 days",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum_over_time(site_day_solar_kwh[30d] offset 365d)",
     "legendFormat": "the same 30 days a year earlier",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "drawStyle": "line",
      "spanNulls": true,
      "showPoints": "never",
      "axisLabel": ""
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "the same 30 days a year earlier"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "interval": "1d",
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
