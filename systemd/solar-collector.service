[Unit]
Description=Solar monitor: weather station and Open-Meteo sunlight data for the advisor
After=network-online.target solar-stack.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/solar-monitor/setup/collector.py --stack /opt/solar-monitor/stack
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
