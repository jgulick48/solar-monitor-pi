[Unit]
Description=Solar monitor: dashboard on the HDMI screen (cage + Chromium kiosk)
# Only when the display is turned on in the setup page, cage and Chromium are installed and a
# screen is connected; a udev rule starts it when a screen is plugged in later.
After=systemd-user-sessions.service plymouth-quit-wait.service solar-web.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty0
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# "+": the check runs as root. It reads state/display.json, which is root's and mode 600 (camera links);
# as solar-display it couldn't, and every start was skipped (v0.2.0-v0.2.7).
ExecCondition=+/usr/bin/python3 /opt/solar-monitor/setup/display.py should-run
ExecStartPre=/usr/bin/python3 /opt/solar-monitor/setup/display.py wait-web
ExecStart=/usr/bin/cage -s -- /opt/solar-monitor/setup/kiosk.sh
Restart=always
RestartSec=10
User=solar-display
PAMName=solar-display
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target multi-user.target
